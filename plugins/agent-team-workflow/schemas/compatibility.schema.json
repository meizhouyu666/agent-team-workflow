{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-team-workflow.invalid/schemas/compatibility.schema.json",
  "title": "Agent Team Workflow compatibility schema 1",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "rows"],
  "properties": {"schema_version": {"const": 1}, "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}},
  "$defs": {"row": {"type": "object", "additionalProperties": false,
    "required": ["id", "status", "os", "architecture", "runtime_kind", "shell", "claude_version", "codex_version", "ccpanes_version_policy", "plugin_version", "role_state_schema", "migration_schema", "envelope_schema", "install_sources", "cache_action", "upgrade_path", "rollback_path", "version_skew", "required_static", "required_capabilities", "required_predicates"],
    "properties": {
      "id": {"type": "string", "minLength": 1}, "status": {"enum": ["SUPPORTED", "TESTED_ONLY", "UNSUPPORTED"]},
      "os": {"type": "string", "minLength": 1}, "architecture": {"type": "string", "minLength": 1}, "runtime_kind": {"type": "string", "minLength": 1}, "shell": {"type": "string", "minLength": 1},
      "claude_version": {"type": "string", "minLength": 1}, "codex_version": {"type": "string", "minLength": 1}, "ccpanes_version_policy": {"type": "string", "minLength": 1}, "plugin_version": {"type": "string", "minLength": 1},
      "role_state_schema": {"const": 1}, "migration_schema": {"const": 1}, "envelope_schema": {"const": 1},
      "install_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "cache_action": {"type": "string", "minLength": 1}, "upgrade_path": {"type": "string", "minLength": 1}, "rollback_path": {"type": "string", "minLength": 1}, "version_skew": {"const": "fail-closed"},
      "required_static": {"type": "object", "minProperties": 1}, "required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "required_predicates": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
    }
  }}
}
