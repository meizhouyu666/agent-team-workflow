{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-team-workflow.invalid/schemas/envelope.schema.json",
  "title": "Agent Team Workflow canonical envelope schema 1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "authority_scope", "message_id", "reply_to", "run_id", "migration_id", "leader_generation", "message_type", "sender", "recipient", "nonce", "created_at", "expires_at", "payload", "payload_path", "payload_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "authority_scope": {"enum": ["ROLE", "CANDIDATE_VALIDATION"]},
    "message_id": {"type": "string", "minLength": 1}, "reply_to": {"type": ["string", "null"], "minLength": 1},
    "run_id": {"type": "string", "minLength": 1}, "migration_id": {"type": ["string", "null"], "minLength": 1},
    "leader_generation": {"type": "integer", "minimum": 0},
    "message_type": {"enum": ["HANDSHAKE", "ASSIGNMENT", "RECEIPT_ACK", "COMPLETION", "REVIEW_REQUEST", "REVIEW_VERDICT", "LEADER_ACTIVATED"]},
    "sender": {"$ref": "#/$defs/party"}, "recipient": {"$ref": "#/$defs/party"},
    "nonce": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"},
    "payload": {}, "payload_path": {"type": ["string", "null"], "minLength": 1},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "oneOf": [
    {"properties": {"payload": {"not": {"type": "null"}}, "payload_path": {"const": null}}, "required": ["payload"]},
    {"properties": {"payload": {"const": null}, "payload_path": {"type": "string", "minLength": 1}}}
  ],
  "allOf": [
    {"if": {"properties": {"authority_scope": {"const": "CANDIDATE_VALIDATION"}}}, "then": {"properties": {"message_type": {"enum": ["HANDSHAKE", "RECEIPT_ACK", "COMPLETION"]}, "migration_id": {"type": "string", "minLength": 1}, "payload": {"type": "object"}}}},
    {"if": {"properties": {"authority_scope": {"const": "ROLE"}, "message_type": {"const": "HANDSHAKE"}, "payload": {"type": "object"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/crossHandshake"}}}},
    {"if": {"properties": {"authority_scope": {"const": "ROLE"}, "message_type": {"const": "ASSIGNMENT"}, "payload": {"type": "object"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/assignment"}}}},
    {"if": {"properties": {"authority_scope": {"const": "ROLE"}, "message_type": {"const": "RECEIPT_ACK"}, "payload": {"type": "object"}}}, "then": {"properties": {"payload": {"oneOf": [{"$ref": "#/$defs/crossReceipt"}, {"$ref": "#/$defs/receipt"}]}}}},
    {"if": {"properties": {"authority_scope": {"const": "ROLE"}, "message_type": {"const": "COMPLETION"}, "payload": {"type": "object"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/completion"}}}},
    {"if": {"properties": {"authority_scope": {"const": "ROLE"}, "message_type": {"const": "REVIEW_REQUEST"}, "payload": {"type": "object"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/reviewRequest"}}}},
    {"if": {"properties": {"authority_scope": {"const": "ROLE"}, "message_type": {"const": "REVIEW_VERDICT"}, "payload": {"type": "object"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/reviewVerdict"}}}},
    {"if": {"properties": {"authority_scope": {"const": "ROLE"}, "message_type": {"const": "LEADER_ACTIVATED"}, "payload": {"type": "object"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/leaderActivated"}}}},
    {"if": {"properties": {"authority_scope": {"const": "CANDIDATE_VALIDATION"}, "message_type": {"const": "HANDSHAKE"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/candidateHandshake"}}}},
    {"if": {"properties": {"authority_scope": {"const": "CANDIDATE_VALIDATION"}, "message_type": {"const": "RECEIPT_ACK"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/candidateReceipt"}}}},
    {"if": {"properties": {"authority_scope": {"const": "CANDIDATE_VALIDATION"}, "message_type": {"const": "COMPLETION"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/candidateCompletion"}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "party": {"type": "object", "additionalProperties": false, "required": ["role", "cli_tool", "session_id", "binding_id"], "properties": {"role": {"enum": ["leader", "executor", "reviewer"]}, "cli_tool": {"type": "string", "minLength": 1}, "session_id": {"type": "string", "minLength": 1}, "binding_id": {"type": "string", "minLength": 1}}},
    "crossHandshake": {"type": "object", "additionalProperties": false, "required": ["probe_kind", "run_id", "nonce"], "properties": {"probe_kind": {"const": "CROSS_CLI_HANDSHAKE"}, "run_id": {"type": "string", "minLength": 1}, "nonce": {"type": "string", "minLength": 1}}},
    "assignment": {"type": "object", "additionalProperties": false, "required": ["spec_path", "spec_sha256", "spec_version", "leader_binding_id", "executor_binding_id", "required_skill"], "properties": {"spec_path": {"type": "string", "minLength": 1}, "spec_sha256": {"$ref": "#/$defs/digest"}, "spec_version": {"type": "integer", "minimum": 1}, "leader_binding_id": {"type": "string", "minLength": 1}, "executor_binding_id": {"type": "string", "minLength": 1}, "required_skill": {"type": "string", "minLength": 1}}},
    "crossReceipt": {"type": "object", "additionalProperties": false, "required": ["probe_kind", "run_id", "nonce", "original_message_id", "canonical_request_hash"], "properties": {"probe_kind": {"const": "CROSS_CLI_HANDSHAKE"}, "run_id": {"type": "string", "minLength": 1}, "nonce": {"type": "string", "minLength": 1}, "original_message_id": {"type": "string", "minLength": 1}, "canonical_request_hash": {"$ref": "#/$defs/digest"}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["original_message_id", "original_nonce", "canonical_request_hash", "accepted", "operation_key"], "properties": {"original_message_id": {"type": "string", "minLength": 1}, "original_nonce": {"type": "string", "minLength": 1}, "canonical_request_hash": {"$ref": "#/$defs/digest"}, "accepted": {"const": true}, "operation_key": {"type": "string", "minLength": 1}}},
    "completion": {"type": "object", "additionalProperties": false, "required": ["original_message_id", "original_nonce", "canonical_request_hash", "status", "result_path", "result_sha256"], "properties": {"original_message_id": {"type": "string", "minLength": 1}, "original_nonce": {"type": "string", "minLength": 1}, "canonical_request_hash": {"$ref": "#/$defs/digest"}, "status": {"enum": ["SUCCEEDED", "FAILED", "INDETERMINATE"]}, "result_path": {"type": ["string", "null"], "minLength": 1}, "result_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}}},
    "reviewRequest": {"type": "object", "additionalProperties": false, "required": ["plan_path", "review_iteration", "review_fingerprint", "review_scope"], "properties": {"plan_path": {"type": "string", "minLength": 1}, "review_iteration": {"type": "integer", "minimum": 1}, "review_fingerprint": {"$ref": "#/$defs/digest"}, "review_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "reviewVerdict": {"type": "object", "additionalProperties": false, "required": ["original_message_id", "original_nonce", "canonical_request_hash", "verdict", "review_path", "review_sha256"], "properties": {"original_message_id": {"type": "string", "minLength": 1}, "original_nonce": {"type": "string", "minLength": 1}, "canonical_request_hash": {"$ref": "#/$defs/digest"}, "verdict": {"enum": ["PASS", "REQUEST_CHANGES", "STALE"]}, "review_path": {"type": "string", "minLength": 1}, "review_sha256": {"$ref": "#/$defs/digest"}}},
    "leaderActivated": {"type": "object", "additionalProperties": false, "required": ["migration_id", "leader_generation", "leader_binding_id", "executor_parent_binding_id", "reviewer_parent_binding_id", "roles_sha256"], "properties": {"migration_id": {"type": "string", "minLength": 1}, "leader_generation": {"type": "integer", "minimum": 1}, "leader_binding_id": {"type": "string", "minLength": 1}, "executor_parent_binding_id": {"type": "string", "minLength": 1}, "reviewer_parent_binding_id": {"type": "string", "minLength": 1}, "roles_sha256": {"$ref": "#/$defs/digest"}}},
    "candidateHandshake": {"type": "object", "additionalProperties": false, "required": ["probe_id", "target_generation", "compatibility_row_id", "compatibility_digest", "candidate_binding_id", "candidate_session_id", "candidate_resume_lineage", "handoff_digest", "ordered_probe_ids", "operation_keys"], "properties": {"probe_id": {"type": "string", "minLength": 1}, "target_generation": {"type": "integer", "minimum": 1}, "compatibility_row_id": {"type": "string", "minLength": 1}, "compatibility_digest": {"$ref": "#/$defs/digest"}, "candidate_binding_id": {"type": "string", "minLength": 1}, "candidate_session_id": {"type": "string", "minLength": 1}, "candidate_resume_lineage": {"type": "string", "minLength": 1}, "handoff_digest": {"$ref": "#/$defs/digest"}, "ordered_probe_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "operation_keys": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}}},
    "candidateReceipt": {"type": "object", "additionalProperties": false, "required": ["original_message_id", "original_nonce", "canonical_request_hash", "migration_id", "probe_id", "candidate_identity"], "properties": {"original_message_id": {"type": "string", "minLength": 1}, "original_nonce": {"type": "string", "minLength": 1}, "canonical_request_hash": {"$ref": "#/$defs/digest"}, "migration_id": {"type": "string", "minLength": 1}, "probe_id": {"type": "string", "minLength": 1}, "candidate_identity": {"$ref": "#/$defs/party"}}},
    "candidateCompletion": {"type": "object", "additionalProperties": false, "required": ["original_message_id", "original_nonce", "canonical_request_hash", "migration_id", "probe_id", "probes", "candidate_binding_readback", "report_delivery_readback"], "properties": {"original_message_id": {"type": "string", "minLength": 1}, "original_nonce": {"type": "string", "minLength": 1}, "canonical_request_hash": {"$ref": "#/$defs/digest"}, "migration_id": {"type": "string", "minLength": 1}, "probe_id": {"type": "string", "minLength": 1}, "probes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["probe_id", "operation_key", "effect_policy", "terminal_outcome", "evidence_digest"], "properties": {"probe_id": {"type": "string", "minLength": 1}, "operation_key": {"type": "string", "minLength": 1}, "effect_policy": {"const": "RECONCILABLE_IDEMPOTENT"}, "terminal_outcome": {"const": "SUCCEEDED"}, "evidence_digest": {"$ref": "#/$defs/digest"}}}}, "candidate_binding_readback": {"type": "object", "additionalProperties": false, "required": ["binding_id"], "properties": {"binding_id": {"type": "string", "minLength": 1}}}, "report_delivery_readback": {"type": "object", "additionalProperties": false, "required": ["operation_key"], "properties": {"operation_key": {"type": "string", "minLength": 1}}}}}
  }
}
